{
  "name": "flan_web",
  "version": "0.1.0",
  "description": "Web (React) extensions enabling AI agents to receive annotated UI feedback from running web apps via Flan MCP.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/keyvez/flan-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/keyvez/flan-mcp.git",
    "directory": "packages/flan_web"
  },
  "keywords": [
    "flan",
    "mcp",
    "ai-agent",
    "react",
    "ui-feedback"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
