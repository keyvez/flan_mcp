{
  "mcpServers": {
    "flan": {
      "command": "dart",
      "args": [
        "run",
        "packages/flan_mcp/bin/flan_mcp_trm.dart",
        "-l",
        "FINEST"
      ],
      "cwd": "."
    },
    "flan-channel": {
      "command": "dart",
      "args": [
        "run",
        "packages/flan_mcp/bin/flan_channel.dart",
        "-l",
        "INFO"
      ],
      "cwd": "."
    }
  }
}
